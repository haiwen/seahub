#: seahub/views/sysadmin.py:696 seahub/views/sysadmin.py:709
#, python-format
msgid "Successfully added user %s."
msgstr "Επιτυχής προσθήκη χρήστη %s."

#: seahub/views/sysadmin.py:711
#, python-format
msgid ""
"Successfully added user %s. But email notification can not be sent, because "
"Email service is not properly configured."
msgstr "Επιτυχής προσθήκη χρήστη %s. αλλά η αποστολή του ηλεκτρονικού μήνυμα απέτυχε, оскільки η υπηρεσία ηλεκτρονικού ταχυδρομείου δεν έχει διαμορφωθεί σωστά."

#: seahub/views/sysadmin.py:766
msgid "Input should be a number"
msgstr "Η εισαγωγή πρέπει να είναι αριθμός"

#: seahub/views/sysadmin.py:772
msgid "Success"
msgstr "Επιτυχία"

#: seahub/views/sysadmin.py:776
