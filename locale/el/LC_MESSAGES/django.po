#, python-format
msgid "Successfully revoke the admin permission of %s"
msgstr "Επιτυχής ανάκληση των δικαιωμάτων διαχειριστή του %s"

#: seahub/views/sysadmin.py:481
msgid "Failed to revoke admin: the user does not exist"
msgstr "Αποτυχία ανάκλησης δικαιωμάτων διαχειριστή: ο χρήστης δεν υπάρχει"

#: seahub/views/sysadmin.py:600
#, python-format
msgid ""
"Successfully reset password to %(passwd)s, an email has been sent to "
"%(user)s."
msgstr "Επιτυχής επαναφορά κωδικού πρόσβασης σε %(passwd)s, έχει σταλεί ένα email στον %(user)s."

#: seahub/views/sysadmin.py:615
msgid "Failed to reset password: user does not exist"
msgstr "Αποτυχία επαναφοράς κωδικού πρόσβασης: ο χρήστης δεν υπάρχει"

